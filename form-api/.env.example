# Copie para form-api/.env (não versione) ou configure direto no Coolify.
# Chave criada em https://resend.com/api-keys
RESEND_API_KEY=re_coloque_sua_chave

# Para onde o e-mail do formulário vai (aceita vários, separados por vírgula)
LEAD_TO=multflooring@gmail.com

# Remetente — o domínio precisa estar verificado no Resend
LEAD_FROM=Mult Flooring <leads@multflooring.com>

# Origens liberadas para chamar a API (se usar o proxy /api/ no nginx, não importa)
ALLOWED_ORIGINS=https://multflooring.com,https://www.multflooring.com

# Porta interna do container
PORT=3000

# true mostra a mensagem de erro do Resend na resposta (só durante a configuração)
DEBUG_ERRORS=false
