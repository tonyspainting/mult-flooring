# Copy to form-api/.env (never commit) or set it directly in Coolify.
# Key created at https://resend.com/api-keys
RESEND_API_KEY=re_coloque_sua_chave

# Where the form e-mail goes (accepts several, comma-separated)
LEAD_TO=multflooring@gmail.com

# Sender: the domain must be verified in Resend
LEAD_FROM=Mult Flooring <leads@multflooring.com>

# Origins allowed to call the API (irrelevant with the /api/ nginx proxy)
ALLOWED_ORIGINS=https://multflooring.com,https://www.multflooring.com

# Porta interna do container
PORT=3000

# true exposes the Resend error message in the response (setup only)
DEBUG_ERRORS=false
