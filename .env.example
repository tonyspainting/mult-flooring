# Site variables (Vite). Build-time: they are baked into the bundle.
#
# Address that receives the form. Empty = /api/lead (same domain),
# with nginx forwarding to the form-api container.
# Fill in only if the API lives on another domain:
#   VITE_FORM_ENDPOINT=https://api.multflooring.com/lead
VITE_FORM_ENDPOINT=
