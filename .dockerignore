# Docker context and cache for Mult Flooring
# Everything that must not enter the build image.

# Dependências e artefatos locais
node_modules
dist
dist-verify
dist-server
build

# Git e edições
.git
.gitignore
.gitattributes

# Segredos: as chaves vêm dos build args do Coolify, nunca daqui
.env
.env.*
!.env.example

# Lockfile do bun (o build usa npm/package-lock.json)
bun.lockb

# Docs e configs de editor
*.md
!README.md
.vscode
.idea
.DS_Store
Thumbs.db

# Logs e temporários
*.log
npm-debug.log*
coverage
.tmp*
